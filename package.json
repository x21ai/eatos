{
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev-preview.mjs",
    "build:dev": "node scripts/build-production.mjs --dist",
    "build": "node scripts/build-production.mjs",
    "start": "yarn workspace web exec next start --port 8080",
    "validate:clean-routes": "node scripts/validate-clean-routes.mjs",
    "typecheck": "yarn workspace web exec tsc --noEmit --incremental false -p tsconfig.json"
  },
  "resolutions": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "next": "^16.2.6",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^7.0.0"
  },
  "packageManager": "yarn@4.12.0"
}
