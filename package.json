{
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "./apps/web/node_modules/.bin/next dev apps/web",
    "build:dev": "./apps/web/node_modules/.bin/next build apps/web && node scripts/prepare-dist.mjs",
    "build": "./apps/web/node_modules/.bin/next build apps/web && node scripts/prepare-dist.mjs",
    "start": "./apps/web/node_modules/.bin/next start apps/web --port 8080",
    "typecheck": "cd apps/web && ./node_modules/.bin/tsc --noEmit -p tsconfig.json"
  },
  "resolutions": {
    "react-native": "patch:react-native@npm%3A0.81.4#~/.yarn/patches/react-native+0.81.4.patch",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-screens": "4.16.0"
  },
  "devDependencies": {
    "eslint": "^9.27.0",
    "oxfmt": "^0.35.0",
    "oxlint": "^1.50.0",
    "typescript-eslint": "^8.33.0"
  },
  "packageManager": "yarn@4.12.0"
}
