{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eatos-web",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "MAYA_CONVERSATION_ROOM",
        "class_name": "MayaConversationRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-maya-realtime",
      "new_sqlite_classes": ["MayaConversationRoom"]
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // D1 (SQLite) replaces Neon Postgres. Run `wrangler d1 create eatos-web-db`
  // and paste the returned database_id below before deploying.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eatos-web-db",
      "database_id": "fc72b629-a94c-407b-9528-ea4e8ec72425",
      "migrations_dir": "migrations"
    }
  ],
  // R2: OpenNext ISR cache + mirrored Lovable media (__l5e/assets-v1).
  // Create with: wrangler r2 bucket create eatos-web-cache|eatos-web-assets
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "eatos-web-cache"
    },
    {
      "binding": "MEDIA_R2",
      "bucket_name": "eatos-web-assets"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://s.eatos.dev",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://s.eatos.dev",
    "NEXT_PUBLIC_CREATE_HOST": "s.eatos.dev"
  }
}
